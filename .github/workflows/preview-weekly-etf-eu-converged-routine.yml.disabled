name: Historical ETF EU converged routine preview (archived)

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  archived:
    runs-on: ubuntu-latest
    steps:
      - name: Historical workflow notice
        run: |
          echo "Archived pre-governance converged routine preview."
          echo "It has no current PR-gate, production, portfolio, or delivery authority."
          echo "Use the governed fresh-package workflow and canonical routine."
          echo "The original implementation remains available in Git history."
